#!/usr/bin/env bash
set -euo pipefail

resolve_plugin_root() {
  if [[ -n "${KNITTEN_PLUGIN_ROOT:-}" ]]; then
    if [[ ! -f "$KNITTEN_PLUGIN_ROOT/scripts/resolve-output.mjs" ]]; then
      printf 'KNITTEN_PLUGIN_ROOT does not contain scripts/resolve-output.mjs: %s\n' "$KNITTEN_PLUGIN_ROOT" >&2
      return 1
    fi
    printf '%s\n' "$KNITTEN_PLUGIN_ROOT"
    return 0
  fi

  if [[ -n "${KNITTEN_MARKETPLACE_ROOT:-}" ]]; then
    local marketplace_plugin_root="$KNITTEN_MARKETPLACE_ROOT/plugins/knitten"
    if [[ ! -f "$marketplace_plugin_root/scripts/resolve-output.mjs" ]]; then
      printf 'KNITTEN_MARKETPLACE_ROOT does not contain plugins/knitten/scripts/resolve-output.mjs: %s\n' "$KNITTEN_MARKETPLACE_ROOT" >&2
      return 1
    fi
    printf '%s\n' "$marketplace_plugin_root"
    return 0
  fi

  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local repo_root
  repo_root="$(cd "$script_dir/.." && pwd)"
  if [[ -f "$repo_root/scripts/resolve-output.mjs" ]]; then
    printf '%s\n' "$repo_root"
    return 0
  fi

  local default_root="$HOME/plugins/knitten"
  if [[ -f "$default_root/scripts/resolve-output.mjs" ]]; then
    printf '%s\n' "$default_root"
    return 0
  fi

  printf 'could not locate Knitten resolve-output.mjs from %s or %s\n' "$repo_root" "$default_root" >&2
  return 1
}

plugin_root="$(resolve_plugin_root)"
exec node "$plugin_root/scripts/resolve-output.mjs" "$@"
