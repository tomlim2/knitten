#!/usr/bin/env bash
set -euo pipefail

resolve_plugin_root() {
  if [[ -n "${KNITTEN_PLUGIN_ROOT:-}" ]]; then
    if [[ ! -x "$KNITTEN_PLUGIN_ROOT/bin/knitten-path" ]]; then
      printf 'KNITTEN_PLUGIN_ROOT does not contain bin/knitten-path: %s\n' "$KNITTEN_PLUGIN_ROOT" >&2
      return 1
    fi
    printf '%s\n' "$KNITTEN_PLUGIN_ROOT"
    return 0
  fi

  if [[ -n "${KNITTEN_PLUGINS_ROOT:-}" ]]; then
    local plugins_root_plugin_root="$KNITTEN_PLUGINS_ROOT/knitten"
    if [[ ! -x "$plugins_root_plugin_root/bin/knitten-path" ]]; then
      printf 'KNITTEN_PLUGINS_ROOT does not contain knitten/bin/knitten-path: %s\n' "$KNITTEN_PLUGINS_ROOT" >&2
      return 1
    fi
    printf '%s\n' "$plugins_root_plugin_root"
    return 0
  fi

  is_cache_root() {
    case "$1" in
      */.codex/plugins/cache/*) return 0 ;;
      *) return 1 ;;
    esac
  }

  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local repo_root
  repo_root="$(cd "$script_dir/.." && pwd)"
  local default_root="$HOME/plugins/knitten"
  if is_cache_root "$repo_root" && [[ -x "$default_root/bin/knitten-path" ]]; then
    printf '%s\n' "$default_root"
    return 0
  fi

  if [[ -x "$repo_root/bin/knitten-path" ]]; then
    printf '%s\n' "$repo_root"
    return 0
  fi

  if [[ -x "$default_root/bin/knitten-path" ]]; then
    printf '%s\n' "$default_root"
    return 0
  fi

  printf 'could not locate Knitten bin/knitten-path from %s or %s\n' "$repo_root" "$default_root" >&2
  return 1
}

plugin_root="$(resolve_plugin_root)"

if [[ $# -eq 1 && ( "$1" == "-h" || "$1" == "--help" ) ]]; then
  printf 'Knitten output resolver supports two modes.\n\n'
  printf 'Skill/kind mode:\n'
  node "$plugin_root/scripts/resolve-output.mjs" --help
  printf '\nRegistered output-id mode:\n'
  node "$plugin_root/scripts/resolve-registered-output.mjs" --help
  exit 0
fi

exec "$plugin_root/bin/knitten-path" output "$@"
