{
  "roots": {
    "obsidian": "machine-paths:obsidian",
    "staging": "machine-paths:obsidian-staging",
    "ops": "~/.claude/ops",
    "private": "~/.claude/private"
  },
  "purposes": {
    "devlog": {
      "default": "obsidian:agent/projects/{project}",
      "no-vault": "staging:agent/projects/{project}"
    },
    "learning": {
      "default": "obsidian:agent/projects/{project}",
      "no-vault": "staging:agent/projects/{project}"
    },
    "learnings": {
      "default": "obsidian:learnings/projects",
      "no-vault": "staging:learnings/projects"
    },
    "topic": {
      "default": "obsidian:agent/projects/{project}/topics",
      "no-vault": "staging:agent/projects/{project}/topics"
    },
    "consulting": {
      "default": "obsidian:consulting",
      "no-vault": "staging:consulting"
    },
    "research": {
      "default": "obsidian:agent/research",
      "no-vault": "staging:agent/research"
    },
    "notes": {
      "default": "obsidian:agent/notes",
      "no-vault": "staging:agent/notes"
    },
    "ops": {
      "default": "ops:"
    },
    "tutoring": {
      "default": "private:tutoring"
    },
    "drinks": {
      "default": "obsidian:drinks",
      "no-vault": "staging:drinks"
    },
    "private-data": {
      "default": "private:"
    },
    "postmortem": {
      "default": "obsidian:agent/projects/records",
      "no-vault": "staging:agent/projects/records"
    },
    "vocab": {
      "default": "obsidian:30-resources/language",
      "no-vault": "staging:30-resources/language"
    },
    "experiment": {
      "default": "obsidian:agent/projects/{project}",
      "no-vault": "staging:agent/projects/{project}"
    },
    "spec": {
      "default": "obsidian:agent/specs",
      "no-vault": "staging:agent/specs"
    },
    "cross-learning": {
      "default": "obsidian:agent/learnings",
      "no-vault": "staging:agent/learnings"
    }
  },
  "format": {
    "obsidian": "obsidian-md",
    "staging": "obsidian-md",
    "ops": "free",
    "private": "free"
  }
}
