{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent artifact pack manifest",
  "type": "object",
  "required": [
    "schema-version",
    "pack-id",
    "display-name",
    "version",
    "visibility",
    "owner-domain",
    "description",
    "exports"
  ],
  "properties": {
    "schema-version": {
      "const": 1
    },
    "pack-id": {
      "$ref": "#/$defs/slug"
    },
    "display-name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "visibility": {
      "enum": ["public", "private", "company", "local"]
    },
    "owner-domain": {
      "enum": ["core", "repo", "company", "personal", "domain", "experiment"]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/export"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "compatibility-aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/compatibilityAlias"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(\\/|[A-Za-z]:[\\\\/]|.*(^|/)\\.\\.(\\/|$)|.*\\\\|.*(^|/)\\.(\\/|$)|.*//)"
      }
    },
    "export": {
      "type": "object",
      "required": [
        "artifact-id",
        "artifact-type",
        "path",
        "shape",
        "mount",
        "load",
        "privacy-risk"
      ],
      "properties": {
        "artifact-id": {
          "$ref": "#/$defs/slug"
        },
        "artifact-type": {
          "enum": ["skill", "rule", "standard", "config", "script", "doc", "fixture", "generated-view", "shim"]
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "shape": {
          "enum": ["file", "directory"]
        },
        "mount": {
          "$ref": "#/$defs/mount"
        },
        "entrypoint": {
          "$ref": "#/$defs/relativePath"
        },
        "load": {
          "enum": ["on-demand", "manual", "route-selected"]
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "privacy-risk": {
          "enum": ["public-safe", "needs-scrub", "private-only", "unknown"]
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "mount": {
      "type": "object",
      "required": ["layer", "target", "mode"],
      "properties": {
        "layer": {
          "enum": ["skills", "rules", "standards", "config", "scripts", "docs", "fixtures", "generated-views", "shims"]
        },
        "target": {
          "$ref": "#/$defs/relativePath"
        },
        "mode": {
          "enum": ["link", "copy", "virtual"]
        }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "properties": {
        "context-profile": {
          "$ref": "#/$defs/slug"
        },
        "domains": {
          "$ref": "#/$defs/stringArray"
        },
        "repo-keys": {
          "$ref": "#/$defs/stringArray"
        },
        "task-types": {
          "$ref": "#/$defs/stringArray"
        },
        "languages": {
          "$ref": "#/$defs/stringArray"
        },
        "frameworks": {
          "$ref": "#/$defs/stringArray"
        },
        "work-modes": {
          "$ref": "#/$defs/stringArray"
        },
        "exclude-when": {
          "$ref": "#/$defs/stringArray"
        },
        "min-evidence": {
          "type": "integer",
          "minimum": 1
        },
        "max-context-bytes": {
          "type": "integer",
          "minimum": 1
        },
        "priority": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "compatibilityAlias": {
      "type": "object",
      "required": ["alias-id", "target-artifact-id", "compatibility-need", "removal-criteria"],
      "properties": {
        "alias-id": {
          "$ref": "#/$defs/slug"
        },
        "target-artifact-id": {
          "$ref": "#/$defs/slug"
        },
        "compatibility-need": {
          "enum": ["alias", "shim", "redirect", "old-path-mapping"]
        },
        "old-name": {
          "type": "string",
          "minLength": 1
        },
        "old-path": {
          "$ref": "#/$defs/relativePath"
        },
        "shim-path": {
          "$ref": "#/$defs/relativePath"
        },
        "deprecation-date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "removal-criteria": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
