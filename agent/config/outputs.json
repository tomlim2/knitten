        "localArtifactTokens": [
          "shotloom",
          "planning",
          "{stl}",
          "brief"
        ]
      },
      "args": [
        {
          "name": "stl",
          "pattern": "^stl-[0-9]+$",
          "normalize": "lowercase"
        }
      ],
      "template": "document-templates/agent-hub/json-handoff-packet.json",
      "format": "json",
