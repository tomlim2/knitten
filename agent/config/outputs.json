{
  "schemaVersion": 1,
  "entries": [
    {
      "id": "local-session-handoff",
      "description": "Agent-hub JSON-only cross-session handoff report",
      "madeBy": "workflow:agent-hub-session-handoff",
      "writeTarget": {
        "kind": "local-artifact",
        "localArtifactTokens": ["ah", "reports", "{date}", "handoff", "{slug}"]
      },
      "args": [
        {
          "name": "date",
          "pattern": "^[0-9]{8}$"
        },
        {
          "name": "slug",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      ],
      "template": "agent/document-templates/agent-hub/json-handoff-packet.json",
      "format": "json"
    },
    {
      "id": "agent-hub-spec-proposed",
      "description": "Agent-hub proposed spec document",
      "madeBy": "ah-manage-spec",
      "writeTarget": {
        "kind": "repo-template",
        "path": "docs/plans/proposed/{slug}.md"
      },
      "args": [
        {
          "name": "slug",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      ],
      "template": "agent/document-templates/agent-hub/spec.md",
      "format": "markdown"
    },
    {
      "id": "agent-hub-design-plan-section",
      "description": "Design Plan section inside an agent-hub proposed spec",
      "madeBy": "ah-manage-spec",
      "writeTarget": {
        "kind": "document-section",
        "parentOutput": "agent-hub-spec-proposed",
        "section": "## Design Plan"
      },
      "args": [
        {
          "name": "slug",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      ],
      "template": "agent/document-templates/agent-hub/design-plan.md",
      "format": "markdown-section"
    }
  ]
}
