{
  "schemaVersion": 1,
  "entries": [
    {
      "id": "local-session-handoff",
      "description": "Agent-hub JSON-only cross-session handoff report",
      "madeBy": "workflow:agent-hub-session-handoff",
      "writeTarget": {
        "kind": "local-artifact",
        "localArtifactTokens": [
          "ah",
          "reports",
          "{date}",
          "handoff",
          "{slug}"
        ]
      },
      "args": [
        {
          "name": "date",
          "pattern": "^[0-9]{8}$"
        },
        {
          "name": "slug",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      ],
      "template": "document-templates/agent-hub/json-handoff-packet.json",
      "format": "json"
    },
    {
      "id": "shotloom-start-task-brief",
