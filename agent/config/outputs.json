{
  "schemaVersion": 1,
  "entries": [
    {
      "id": "local-session-handoff",
      "description": "Shared workflow JSON-only cross-session handoff report",
      "madeBy": "workflow:shared-session-handoff",
      "writeTarget": {
        "kind": "local-artifact",
        "localArtifactTokens": [
          "workflow",
          "reports",
          "{date}",
          "handoff",
          "{slug}"
        ]
      },
      "args": [
        {
          "name": "date",
          "pattern": "^[0-9]{8}$"
        },
        {
          "name": "slug",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      ],
      "template": "document-templates/workflow/json-handoff-packet.json",
      "format": "json"
    }
  ]
}
