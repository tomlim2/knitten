{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent artifact inventory",
  "type": "object",
  "required": ["schema-version", "rows"],
  "properties": {
    "schema-version": {
      "const": 1
    },
    "generated-at": {
      "type": "string",
      "format": "date-time"
    },
    "source-commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "rows": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/artifactRow"
          },
          {
            "$ref": "#/$defs/skillRow"
          },
          {
            "$ref": "#/$defs/extractionItemRow"
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "commonRow": {
      "type": "object",
      "required": [
        "row-id",
        "row-type",
        "source-artifact-path",
        "artifact-type",
        "owner-domain",
        "privacy-risk",
        "dependencies",
        "proposed-destination",
        "compatibility-need",
        "classification-stage",
        "review-state"
      ],
      "properties": {
        "row-id": {
          "type": "string",
          "pattern": "^(artifact|skill|extraction):.+"
        },
        "row-type": {
          "enum": ["artifact", "skill", "extraction-item"]
        },
        "source-artifact-path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^(/Users/|[A-Za-z]:\\\\)"
          }
        },
        "artifact-type": {
          "$ref": "#/$defs/artifactType"
        },
        "owner-domain": {
          "enum": ["core", "repo", "company", "personal", "domain", "experiment", "unknown"]
        },
        "privacy-risk": {
          "enum": ["public-safe", "needs-scrub", "private-only", "unknown"]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "proposed-destination": {
          "enum": [
            "knitten-core",
            "knitten-private-pack",
            "domain-pack",
            "deprecated",
            "migrate-later",
            "undecided"
          ]
        },
        "compatibility-need": {
          "enum": ["alias", "shim", "redirect", "old-path-mapping", "none", "unknown"]
        },
        "classification-stage": {
          "enum": ["undecided", "core-candidate", "pack-candidate", "deprecated", "migrate-later"]
        },
        "review-state": {
          "enum": ["pending", "accepted", "blocked", "moved"]
        }
      }
    },
    "artifactRow": {
      "allOf": [
        {
          "$ref": "#/$defs/commonRow"
        },
        {
          "type": "object",
          "required": ["row-type"],
          "properties": {
            "row-type": {
              "const": "artifact"
            },
            "artifact-type": {
              "$ref": "#/$defs/nonSkillArtifactType"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "skillRow": {
      "allOf": [
        {
          "$ref": "#/$defs/commonRow"
        },
        {
          "type": "object",
          "required": ["row-type", "body-shape", "core-skill-role", "extraction-count"],
          "properties": {
            "row-type": {
              "const": "skill"
            },
            "artifact-type": {
              "const": "skill"
            },
            "body-shape": {
              "enum": ["thin", "mixed", "guide-heavy", "reference-heavy", "unknown"]
            },
            "core-skill-role": {
              "enum": ["bootstrap", "router", "lifecycle", "domain", "repo-specific", "none"]
            },
            "extraction-count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "extractionItemRow": {
      "allOf": [
        {
          "$ref": "#/$defs/commonRow"
        },
        {
          "type": "object",
          "required": [
            "row-type",
            "parent-row-id",
            "extraction-id",
            "source-section",
            "content-kind",
            "extracted-artifact-type",
            "artifact-subkind",
            "target-path",
            "required-at-runtime",
            "validation-needed"
          ],
          "properties": {
            "row-type": {
              "const": "extraction-item"
            },
            "artifact-type": {
              "const": "skill"
            },
            "parent-row-id": {
              "type": "string",
              "pattern": "^skill:.+"
            },
            "extraction-id": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "source-section": {
              "type": "string",
              "minLength": 1
            },
            "content-kind": {
              "enum": [
                "judgment",
                "example",
                "output-body",
                "naming-policy",
                "lifecycle-policy",
                "domain-reference",
                "machine-checkable-contract"
              ]
            },
            "extracted-artifact-type": {
              "$ref": "#/$defs/artifactType"
            },
            "artifact-subkind": {
              "enum": ["guide", "reference", "document-template", "validator-check", "rubric", "example", "none"]
            },
            "target-path": {
              "type": "string",
              "minLength": 1,
              "not": {
                "pattern": "^(/Users/|[A-Za-z]:\\\\)"
              }
            },
            "required-at-runtime": {
              "enum": ["yes", "no", "unknown"]
            },
            "validation-needed": {
              "enum": ["yes", "no", "unknown"]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "artifactType": {
      "enum": ["skill", "command", "rule", "standard", "config", "script", "doc", "fixture", "generated-view", "shim"]
    },
    "nonSkillArtifactType": {
      "enum": ["command", "rule", "standard", "config", "script", "doc", "fixture", "generated-view", "shim"]
    }
  }
}
