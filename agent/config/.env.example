# Claude Code secret tokens — copy to .env and fill in values
# .env is gitignored. Never commit real tokens.
#
# Convention: {SERVICE}_{KEY}

# --- Slack ---
# cci Slack bot ("아트 아르리므"). Scope: chat:write.customize
SLACK_BOT_TOKEN=xoxb-...

# Shotloom Slack bot (if separate from cci) — uncomment if needed
# SHOTLOOM_SLACK_BOT_TOKEN=xoxb-...

# --- AI services (add as needed) ---
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
