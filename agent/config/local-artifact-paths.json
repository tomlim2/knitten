{
  "schemaVersion": 1,
  "root": ".agent-local",
  "entries": [
    {
      "owner": "workflow",
      "artifactType": "reports",
      "item": "handoff",
      "kind": "file",
      "args": [
        {
          "name": "date",
          "pattern": "^[0-9]{8}$"
        },
        {
          "name": "slug",
          "pattern": "^[a-zA-Z0-9._-]+$",
          "position": "after-item"
        }
      ],
      "path": ".agent-local/reports/{date}-{slug}.json",
      "cleanupPath": ".agent-local/reports",
      "description": "Shared workflow JSON-only cross-session handoff report",
      "template": "document-templates/workflow/json-handoff-packet.json",
      "schemaKind": "session-handoff"
    },
    {
      "owner": "workflow",
      "artifactType": "operational-findings",
      "item": "inbox",
      "kind": "file",
      "args": [
        {
          "name": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      ],
      "path": ".agent-local/workflow/operational-findings/{date}/inbox.json",
      "cleanupPath": ".agent-local/workflow/operational-findings/{date}",
      "description": "Shared workflow operational findings inbox",
      "schemaKind": "operational-findings-inbox"
    },
    {
      "owner": "workflow",
      "artifactType": "operational-findings",
      "item": "report",
      "kind": "file",
      "args": [
        {
          "name": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "name": "slug",
          "pattern": "^[a-zA-Z0-9._-]+$",
          "position": "after-item"
        }
      ],
      "path": ".agent-local/workflow/operational-findings/{date}/reports/{slug}.json",
      "cleanupPath": ".agent-local/workflow/operational-findings/{date}",
      "description": "Shared workflow operational finding report",
      "schemaKind": "operational-finding-report"
    }
  ]
}
