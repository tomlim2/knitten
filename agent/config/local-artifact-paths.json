{
  "schemaVersion": 1,
  "root": ".agent-local",
  "entries": [
    {
      "owner": "workflow",
      "artifactType": "reports",
      "item": "handoff",
      "kind": "file",
      "args": [
        {
          "name": "date",
          "pattern": "^[0-9]{8}$"
        },
        {
          "name": "slug",
          "pattern": "^[a-zA-Z0-9._-]+$",
          "position": "after-item"
        }
      ],
      "path": ".agent-local/reports/{date}-{slug}.json",
      "cleanupPath": ".agent-local/reports",
      "description": "Shared workflow JSON-only cross-session handoff report",
      "template": "document-templates/workflow/json-handoff-packet.json",
      "schemaKind": "session-handoff"
    },
    {
      "owner": "workflow",
      "artifactType": "runs",
      "item": "root",
      "kind": "directory",
      "args": [
        {
          "name": "slug",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "position": "after-item"
        }
      ],
      "path": ".agent-local/workflow/runs/{slug}",
      "cleanupPath": ".agent-local/workflow/runs/{slug}",
      "description": "Shared workflow run artifact root",
      "schemaKind": "workflow-run-root"
    },
    {
      "owner": "workflow",
      "artifactType": "runs",
      "item": "raw",
      "kind": "directory",
      "args": [
        {
          "name": "slug",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "position": "after-item"
        }
      ],
      "path": ".agent-local/workflow/runs/{slug}/raw",
      "cleanupPath": ".agent-local/workflow/runs/{slug}",
      "description": "Raw evidence directory for a shared workflow run",
      "schemaKind": "workflow-run-raw"
    },
    {
      "owner": "workflow",
      "artifactType": "runs",
      "item": "summary",
      "kind": "file",
      "args": [
        {
          "name": "slug",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "position": "after-item"
        }
      ],
      "path": ".agent-local/workflow/runs/{slug}/summary.md",
      "cleanupPath": ".agent-local/workflow/runs/{slug}",
      "description": "Compact human-readable summary for a shared workflow run",
      "schemaKind": "workflow-run-summary"
    },
    {
      "owner": "workflow",
      "artifactType": "runs",
      "item": "handoff",
      "kind": "file",
      "args": [
        {
          "name": "slug",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "position": "after-item"
        }
      ],
      "path": ".agent-local/workflow/runs/{slug}/handoff.json",
      "cleanupPath": ".agent-local/workflow/runs/{slug}",
      "description": "Machine-readable resume state for a shared workflow run",
      "schemaKind": "workflow-run-handoff"
    },
    {
      "owner": "workflow",
      "artifactType": "runs",
      "item": "next",
      "kind": "file",
      "args": [
        {
          "name": "slug",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "position": "after-item"
        }
      ],
      "path": ".agent-local/workflow/runs/{slug}/next.md",
      "cleanupPath": ".agent-local/workflow/runs/{slug}",
      "description": "Immediate next action or blocker for a shared workflow run",
      "schemaKind": "workflow-run-next"
    },
    {
      "owner": "workflow",
      "artifactType": "operational-findings",
      "item": "inbox",
      "kind": "file",
      "args": [
        {
          "name": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      ],
      "path": ".agent-local/workflow/operational-findings/{date}/inbox.json",
      "cleanupPath": ".agent-local/workflow/operational-findings/{date}",
      "description": "Shared workflow operational findings inbox",
      "schemaKind": "operational-findings-inbox"
    },
    {
      "owner": "workflow",
      "artifactType": "operational-findings",
      "item": "report",
      "kind": "file",
      "args": [
        {
          "name": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "name": "slug",
          "pattern": "^[a-zA-Z0-9._-]+$",
          "position": "after-item"
        }
      ],
      "path": ".agent-local/workflow/operational-findings/{date}/reports/{slug}.json",
      "cleanupPath": ".agent-local/workflow/operational-findings/{date}",
      "description": "Shared workflow operational finding report",
      "schemaKind": "operational-finding-report"
    },
    {
      "owner": "workflow",
      "artifactType": "json",
      "item": "temp",
      "kind": "file",
      "args": [
        {
          "name": "slug",
          "pattern": "^[^/]+$",
          "position": "after-item"
        }
      ],
      "path": ".agent-local/workflow/json/{slug}.json",
      "cleanupPath": ".agent-local/workflow/json",
      "description": "Temporary shared workflow JSON",
      "schemaKind": "workflow-temp-json"
    },
    {
      "owner": "workflow",
      "artifactType": "reviews",
      "item": "review",
      "kind": "file",
      "args": [
        {
          "name": "slug",
          "pattern": "^[^/]+$",
          "position": "after-item"
        }
      ],
      "path": ".agent-local/workflow/reviews/{slug}.json",
      "cleanupPath": ".agent-local/workflow/reviews",
      "description": "Shared workflow review JSON",
      "schemaKind": "workflow-review-json"
    },
    {
      "owner": "workflow",
      "artifactType": "reports",
      "item": "markdown",
      "kind": "file",
      "args": [
        {
          "name": "slug",
          "pattern": "^[^/]+$",
          "position": "after-item"
        }
      ],
      "path": ".agent-local/workflow/reports/{slug}.md",
      "cleanupPath": ".agent-local/workflow/reports",
      "description": "Shared workflow Markdown report",
      "schemaKind": "workflow-report-markdown"
    },
    {
      "owner": "workflow",
      "artifactType": "reports",
      "item": "html",
      "kind": "file",
      "args": [
        {
          "name": "slug",
          "pattern": "^[^/]+$",
          "position": "after-item"
        }
      ],
      "path": ".agent-local/workflow/reports/{slug}.html",
      "cleanupPath": ".agent-local/workflow/reports",
      "description": "Shared workflow HTML report",
      "schemaKind": "workflow-report-html"
    },
    {
      "owner": "workflow",
      "artifactType": "tasks",
      "item": "task",
      "kind": "file",
      "args": [
        {
          "name": "slug",
          "pattern": "^[^/]+$",
          "position": "after-item"
        }
      ],
      "path": ".agent-local/workflow/tasks/{slug}.json",
      "cleanupPath": ".agent-local/workflow/tasks",
      "description": "Shared workflow task JSON",
      "schemaKind": "workflow-task-json"
    },
    {
      "owner": "workflow",
      "artifactType": "gallery",
      "item": "root",
      "kind": "directory",
      "args": [],
      "path": ".agent-local/gallery",
      "cleanupPath": ".agent-local/gallery",
      "description": "Knitten daily image gallery root",
      "schemaKind": "knitten-gallery-root"
    }
  ]
}
