# Personal data (learnings, specs, skill-usage are tracked)
claude/private/*
!claude/private/learnings/
!claude/private/specs/
!claude/private/skill-usage/
# Shared cross-machine doc routing registry (per-purpose subpaths)
!claude/private/caol-config/
claude/private/caol-config/*
!claude/private/caol-config/doc-paths.json

# Secrets
*.env
credentials*.json

# Runtime files (auto-generated by Claude Code)
claude/history.jsonl
claude/settings.json
claude/settings.local.json
claude/todos/
claude/projects/
claude/file-history/
claude/shell-snapshots/
claude/agents/
claude/cache/
claude/debug/
claude/hooks/*.log
claude/hooks/*.err
claude/ide/
claude/stats-cache.json
claude/plans/
claude/session-env/
claude/statsig/
claude/backups/
claude/sessions/
claude/tasks/
claude/telemetry/
claude/plugins/
claude/paste-cache/
claude/mcp-needs-auth-cache.json
claude/image-cache/

# Future-proof: catch any new runtime files
claude/*.log
claude/logs/
claude/temp/
claude/tmp/

# Python cache
__pycache__/
*.pyc

# Font binaries in skills
claude/skills/canvas-design/canvas-fonts/

# Skill server runtime
claude/skills/skill-server/node_modules/
claude/skills/skill-server/package-lock.json

# Claude Code session logs
*.txt

# OS files
.DS_Store
Thumbs.db

# Stray root-level Claude Code runtime dir
.claude/

# Hyperframes runtime
hyperframes/node_modules/
hyperframes/package-lock.json
hyperframes/output/
hyperframes/renders/
hyperframes/.hyperframes/
hyperframes/transcript.json
hyperframes/*.mp4
hyperframes/*.mov
hyperframes/*.webm
