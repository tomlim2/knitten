# Personal data (learnings, specs, skill-usage are tracked)
agent/private/*
!agent/private/learnings/
!agent/private/specs/
!agent/private/skill-usage/
# Shared cross-machine doc routing registry (per-purpose subpaths)
!agent/private/caol-config/
agent/private/caol-config/*
!agent/private/caol-config/doc-paths.json
!agent/private/caol-config/vault-structure.json

# Secrets
*.env
credentials*.json

# Runtime files (auto-generated by Claude Code)
agent/.last-cleanup
agent/history.jsonl
# agent/settings.json — tracked: portable Claude Code config.
# Per-machine secrets / paths belong in agent/settings.local.json, which stays gitignored.
agent/settings.local.json
agent/todos/
agent/projects/
agent/file-history/
agent/shell-snapshots/
agent/agents/
agent/cache/
agent/debug/
agent/hooks/*.log
agent/hooks/*.err
agent/ide/
agent/stats-cache.json
agent/plans/
agent/session-env/
agent/statsig/
agent/backups/
agent/sessions/
agent/tasks/
agent/telemetry/
agent/plugins/
agent/paste-cache/
agent/mcp-needs-auth-cache.json
agent/image-cache/

# External upstream skill vendors.
# Registry and sync script are tracked; cloned vendor repos are local runtime.
agent/vendor/*
!agent/vendor/README.md
!agent/vendor/skills.json
!agent/vendor/sync.sh

# Future-proof: catch any new runtime files
agent/*.log
agent/logs/
agent/temp/
agent/tmp/
tmp/

# Python cache
__pycache__/
*.pyc

# Codex-managed system skills — auto-generated per machine, not portable.
# The `.codex-system-skills.marker` rewrites on every codex run.
agent/skills/.system/

# Font binaries in skills
agent/skills/canvas-design/canvas-fonts/

# Skill server runtime
agent/skills/skill-server/node_modules/
agent/skills/skill-server/package-lock.json
claude/skills/skill-server/node_modules/
claude/skills/skill-server/package-lock.json

# Claude Code session logs
*.txt
!agent/skills/**/LICENSE.txt

# OS files
.DS_Store
Thumbs.db

# Stray root-level Claude Code runtime dir
.claude/

# Hyperframes runtime
hyperframes/node_modules/
hyperframes/package-lock.json
hyperframes/output/
hyperframes/renders/
hyperframes/.hyperframes/
hyperframes/transcript.json
hyperframes/*.mp4
hyperframes/*.mov
hyperframes/*.webm

# pi coding agent runtime
.pi/
