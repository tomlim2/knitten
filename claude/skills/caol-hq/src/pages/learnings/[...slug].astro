---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { readDoc } from '../../lib/doc-discovery';
import { obsidianClaudeDir } from '../../lib/paths';
import { renderMarkdown } from '../../lib/markdown';
import { join } from 'node:path';

const slug = Astro.params.slug as string;
const claudeDir = obsidianClaudeDir();
const root = claudeDir ? join(claudeDir, 'learnings') : null;
const doc = root ? readDoc(root, slug) : null;
if (!doc) {
    return Astro.redirect('/learnings');
}
const html = renderMarkdown(doc.content);
const fmtDate = doc.mtime.toLocaleString('ko-KR', { dateStyle: 'short', timeStyle: 'short' });
---

<BaseLayout title={slug} activeNav="/browse">
    <nav class="hq-crumb"><a href="/learnings">← Learnings</a></nav>
    <PageHero title={slug} sub={`last modified ${fmtDate}`} />
    <article class="hq-md" set:html={html}></article>
</BaseLayout>
