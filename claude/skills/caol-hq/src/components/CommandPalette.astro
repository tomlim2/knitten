---
// Command palette — global keyboard launcher (⌘K / Ctrl+K).
// Index is fetched lazily from /api/palette-index.json on first open
// (review-code-astro.md PERF-A07) so the page HTML stays small even
// as the skill set grows. List items are built with DOM APIs, never
// innerHTML interpolation, to keep SEC-A03 spirit.
---

<div id="hq-palette" class="hq-palette" hidden>
    <div class="hq-palette-backdrop" data-close></div>
    <div class="hq-palette-modal" role="dialog" aria-label="Command palette">
        <input
            type="search"
            id="hq-palette-input"
            placeholder="Type to filter — skill / page / shortcut"
            autocomplete="off"
            spellcheck="false"
        />
        <ul id="hq-palette-list" class="hq-palette-list"></ul>
        <footer class="hq-palette-foot">
            <span><kbd>↑</kbd><kbd>↓</kbd> 이동</span>
            <span><kbd>↵</kbd> 열기</span>
            <span><kbd>Esc</kbd> 닫기</span>
        </footer>
    </div>
</div>

<script is:inline>
    (() => {
        const palette = document.getElementById('hq-palette');
        const input = document.getElementById('hq-palette-input');
        const list = document.getElementById('hq-palette-list');
        if (!palette || !input || !list) return;

        const MAX = 30;
        let cursor = 0;
        /** @type {Array<{kind:string,label:string,sub:string,href:string}>|null} */
        let index = null;
        let indexLoading = null;

        function loadIndex() {
            if (index) return Promise.resolve(index);
            if (!indexLoading) {
                indexLoading = fetch('/api/palette-index.json')
                    .then(r => r.json())
                    .then(rows => { index = rows; return rows; })
                    .catch(() => { indexLoading = null; index = []; return index; });
            }
            return indexLoading;
        }

        function render(filter) {
            const data = index ?? [];
            const q = filter.trim().toLowerCase();
            const matches = q
                ? data.filter(i => `${i.label} ${i.sub}`.toLowerCase().includes(q))
                : data.slice(0, MAX);
            const shown = matches.slice(0, MAX);
            // DOM API instead of innerHTML — SEC-A03 spirit.
            list.replaceChildren();
            shown.forEach((m, i) => {
                const li = document.createElement('li');
                li.dataset.href = m.href;
                li.dataset.i = String(i);
                if (i === cursor) li.classList.add('hq-palette-active');
                const k = document.createElement('span');
                k.className = 'hq-palette-kind';
                k.textContent = m.kind;
                const lbl = document.createElement('span');
                lbl.className = 'hq-palette-label';
                lbl.textContent = m.label;
                const sub = document.createElement('span');
                sub.className = 'hq-palette-sub';
                sub.textContent = m.sub ?? '';
                li.append(k, lbl, sub);
                list.append(li);
            });
        }

        async function open() {
            palette.hidden = false;
            cursor = 0;
            input.value = '';
            list.replaceChildren();
            await loadIndex();
            render('');
            requestAnimationFrame(() => input.focus());
        }
        function close() { palette.hidden = true; }
        function move(delta) {
            const items = list.querySelectorAll('li');
            if (!items.length) return;
            cursor = (cursor + delta + items.length) % items.length;
            items.forEach((el, i) => el.classList.toggle('hq-palette-active', i === cursor));
            items[cursor].scrollIntoView({ block: 'nearest' });
        }
        function activate() {
            const el = list.querySelector('li.hq-palette-active');
            if (!el) return;
            const href = el.getAttribute('data-href');
            if (href) location.href = href;
        }

        document.addEventListener('keydown', (e) => {
            const isMeta = e.metaKey || e.ctrlKey;
            if (isMeta && e.key === 'k') {
                e.preventDefault();
                palette.hidden ? open() : close();
                return;
            }
            if (palette.hidden) return;
            if (e.key === 'Escape') { close(); return; }
            if (e.key === 'ArrowDown') { e.preventDefault(); move(1); return; }
            if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); return; }
            if (e.key === 'Enter') { e.preventDefault(); activate(); return; }
        });
        input.addEventListener('input', () => { cursor = 0; render(input.value); });
        list.addEventListener('click', (e) => {
            const li = e.target.closest('li');
            if (!li) return;
            const href = li.getAttribute('data-href');
            if (href) location.href = href;
        });
        palette.querySelector('[data-close]').addEventListener('click', close);
    })();
</script>
