---
import WidgetFrame from '../WidgetFrame.astro';
import EmptyState from '../EmptyState.astro';
import { exec } from 'node:child_process';
import { promisify } from 'node:util';
import { existsSync } from 'node:fs';
import { loadRepoPaths, getRepoPath } from '../../lib/paths';

const execAsync = promisify(exec);

interface PR {
    repo: string;
    number: number;
    title: string;
    isDraft: boolean;
    state: string;
    url: string;
}

interface CacheEntry {
    at: number;
    prs: PR[];
    scanned: number;
    skipped: number;
}

const TTL_MS = 60_000;
const cacheKey = '__openPRsCache';
const g = globalThis as unknown as { [k: string]: CacheEntry | undefined };
const cached = g[cacheKey];

let prs: PR[] = [];
let scanned = 0;
let skipped = 0;

if (cached && Date.now() - cached.at < TTL_MS) {
    prs = cached.prs;
    scanned = cached.scanned;
    skipped = cached.skipped;
} else {
    const repos = loadRepoPaths();
    const tasks = Object.entries(repos).map(async ([name, entry]): Promise<{ ok: boolean; prs: PR[] }> => {
        const repoPath = getRepoPath(entry);
        if (!repoPath || !existsSync(repoPath)) return { ok: false, prs: [] };
        try {
            const { stdout } = await execAsync(
                'gh pr list --author @me --state open --json number,title,isDraft,state,url --limit 5',
                { cwd: repoPath, encoding: 'utf8', timeout: 4000 },
            );
            const out = stdout.trim();
            if (!out) return { ok: true, prs: [] };
            const list = JSON.parse(out) as Array<Omit<PR, 'repo'>>;
            return { ok: true, prs: list.map(p => ({ repo: name, ...p })) };
        } catch {
            return { ok: false, prs: [] };
        }
    });
    const results = await Promise.all(tasks);
    for (const r of results) {
        if (r.ok) scanned++;
        else skipped++;
        prs.push(...r.prs);
    }
    prs.sort((a, b) => a.repo.localeCompare(b.repo) || a.number - b.number);
    g[cacheKey] = { at: Date.now(), prs, scanned, skipped };
}
---

<WidgetFrame title="Open PRs" id="open-prs">
    <Fragment slot="meta">{prs.length} open · {scanned}/{scanned + skipped} scanned</Fragment>
    {prs.length === 0 ? (
        <EmptyState>현재 author=@me 인 열린 PR 없음</EmptyState>
    ) : (
        <ul class="hq-doc-list">
            {prs.map(p => (
                <li class="hq-doc-row">
                    <a href={p.url} class="hq-doc-name" target="_blank" rel="noreferrer">
                        <code style="font-size:11px;color:var(--color-gray-mid);">{p.repo}</code>
                        #{p.number} {p.title}
                        {p.isDraft && <span style="font-size:10px;color:var(--color-gray-mid);"> · draft</span>}
                    </a>
                </li>
            ))}
        </ul>
    )}
</WidgetFrame>
