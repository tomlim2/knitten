---
import WidgetFrame from '../WidgetFrame.astro';
import EmptyState from '../EmptyState.astro';
import { exec } from 'node:child_process';
import { promisify } from 'node:util';
import { existsSync } from 'node:fs';
import { loadRepoPaths, getRepoPath } from '../../lib/paths';

const execAsync = promisify(exec);

interface Worktree {
    repo: string;
    path: string;
    branch: string;
}

interface CacheEntry { at: number; trees: Worktree[]; }
const TTL_MS = 60_000;
const cacheKey = '__worktreesCache';
const g = globalThis as unknown as { [k: string]: CacheEntry | undefined };
const cached = g[cacheKey];

let trees: Worktree[] = [];

if (cached && Date.now() - cached.at < TTL_MS) {
    trees = cached.trees;
} else {
    const repos = loadRepoPaths();
    // Parallel `git worktree list` (review-code-astro.md PERF-A01; same fix
    // shape as OpenPRsWidget commit `83c4ed5`).
    const results = await Promise.all(
        Object.entries(repos).map(async ([name, entry]): Promise<Worktree[]> => {
            const repoPath = getRepoPath(entry);
            if (!repoPath || !existsSync(repoPath)) return [];
            try {
                const { stdout } = await execAsync('git worktree list --porcelain', {
                    cwd: repoPath, encoding: 'utf8', timeout: 2000,
                });
                const out: Worktree[] = [];
                let cur: Partial<Worktree> = {};
                for (const line of stdout.split('\n')) {
                    if (line.startsWith('worktree ')) cur.path = line.slice(9).trim();
                    else if (line.startsWith('branch ')) cur.branch = line.slice(7).replace('refs/heads/', '');
                    else if (line === '' && cur.path) {
                        if (cur.path !== repoPath) {
                            out.push({ repo: name, path: cur.path, branch: cur.branch ?? '(detached)' });
                        }
                        cur = {};
                    }
                }
                return out;
            } catch {
                return [];
            }
        }),
    );
    for (const r of results) trees.push(...r);
    trees.sort((a, b) => a.repo.localeCompare(b.repo));
    g[cacheKey] = { at: Date.now(), trees };
}
---

<WidgetFrame title="Worktrees" id="worktrees">
    <Fragment slot="meta">{trees.length} 개</Fragment>
    {trees.length === 0 ? (
        <EmptyState>활성 worktree 없음</EmptyState>
    ) : (
        <ul class="hq-doc-list">
            {trees.map(t => (
                <li class="hq-doc-row">
                    <span class="hq-doc-name">
                        <code style="font-size:11px;color:var(--color-gray-mid);">{t.repo}</code>
                        {t.branch}
                    </span>
                    <span class="hq-doc-date" style="font-size:11px;">{t.path.split('/').slice(-1)[0]}</span>
                </li>
            ))}
        </ul>
    )}
</WidgetFrame>
