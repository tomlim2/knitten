<!-- Design System: v1.9.0 -->
<!DOCTYPE html>
<html lang="ko">
<head>
    <%- include('partials/head', {config}) %>
    <style>
        .gallery-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
        }
        .gallery-header h1 {
            margin-bottom: 0;
        }
        .btn-add {
            padding: 8px 16px;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            background: var(--color-black);
            color: var(--color-white);
            border: none;
            cursor: pointer;
            transition: background 0.15s;
        }
        .btn-add:hover { background: var(--color-text); }

        .prompt-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 24px;
        }
        .prompt-card {
            background: var(--color-white);
            border: 1px solid var(--color-border);
            padding: 20px;
            cursor: pointer;
            transition: border-color 0.15s;
            display: flex;
            flex-direction: column;
            position: relative;
            height: 180px;
        }
        .prompt-card:hover {
            border-color: var(--color-black);
        }
        .prompt-card-title {
            font-size: 14px;
            font-weight: 500;
            color: var(--color-black);
            margin-bottom: 8px;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }
        .prompt-card-text {
            font-size: 12px;
            color: var(--color-gray-dark);
            line-height: 1.5;
            flex: 1;
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
        }
        .prompt-card-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 12px;
            padding-top: 8px;
            border-top: 1px solid var(--color-border);
        }
        .prompt-badge {
            font-size: 11px;
            color: var(--color-gray-mid);
            padding: 2px 6px;
            border: 1px solid var(--color-border);
        }
        .prompt-tags {
            font-size: 11px;
            color: var(--color-gray-mid);
            flex: 1;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }
        a.btn-icon {
            text-decoration: none;
        }
        .prompt-card-actions {
            position: absolute;
            top: 8px;
            right: 8px;
            display: flex;
            gap: 4px;
            opacity: 0;
            transition: opacity 0.15s;
        }
        .prompt-card:hover .prompt-card-actions {
            opacity: 1;
        }
        .btn-icon {
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--color-white);
            border: 1px solid var(--color-border);
            cursor: pointer;
            color: var(--color-gray-dark);
            transition: all 0.15s;
        }
        .btn-icon svg {
            width: 14px;
            height: 14px;
            fill: currentColor;
        }
        .btn-icon:hover {
            border-color: var(--color-black);
            color: var(--color-black);
        }
        .btn-icon.delete:hover {
            border-color: #d32f2f;
            color: #d32f2f;
        }

        /* Add form overlay */
        .form-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.3);
            z-index: 100;
            align-items: center;
            justify-content: center;
        }
        .form-overlay.active {
            display: flex;
        }
        .form-panel {
            background: var(--color-white);
            border: 1px solid var(--color-border);
            padding: 28px;
            width: 560px;
            max-height: 90vh;
            overflow-y: auto;
        }
        .form-panel h2 {
            font-size: 16px;
            font-weight: 400;
            margin-bottom: 24px;
            margin-top: 0;
        }
        .form-field {
            margin-bottom: 16px;
        }
        .form-field label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--color-gray-mid);
            margin-bottom: 6px;
        }
        .form-field input,
        .form-field select,
        .form-field textarea {
            width: 100%;
            padding: 8px 0;
            border: none;
            border-bottom: 1px solid var(--color-border);
            font-size: 14px;
            font-family: inherit;
            background: transparent;
            transition: border-color 0.15s;
        }
        .form-field textarea {
            min-height: 80px;
            resize: vertical;
        }
        .form-field input:focus,
        .form-field select:focus,
        .form-field textarea:focus {
            outline: none;
            border-bottom-color: var(--color-black);
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        .form-actions {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
            margin-top: 24px;
        }

        .toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: var(--color-black);
            color: var(--color-white);
            padding: 10px 16px;
            font-size: 12px;
            z-index: 200;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .toast.show { opacity: 1; }

        @media (max-width: 768px) {
            .prompt-grid { grid-template-columns: 1fr; }
            .form-panel { width: 90vw; }
        }
    </style>
</head>
<body>
    <%- include('partials/header', {config, activePage}) %>
    <main class="main">
        <div class="gallery-header">
            <h1>Prompt Gallery</h1>
            <div style="display:flex;gap:8px;">
                <button class="btn-add" style="background:transparent;color:var(--color-gray-dark);border:1px solid var(--color-border);" onclick="fetchNew()" id="btnFetch">Fetch New</button>
                <button class="btn-add" onclick="openForm()">Add Prompt</button>
            </div>
        </div>

        <div id="galleryContent"></div>
    </main>
    <%- include('partials/footer', {config}) %>

    <!-- Add/Edit Form -->
    <div class="form-overlay" id="formOverlay" onclick="if(event.target===this)closeForm()">
        <div class="form-panel">
            <h2 id="formTitle">Add Prompt</h2>
            <input type="hidden" id="editCategory" value="">
            <input type="hidden" id="editIndex" value="">
            <div class="form-field">
                <label>Title</label>
                <input type="text" id="fTitle" placeholder="e.g. Anime Portrait">
            </div>
            <div class="form-field">
                <label>Prompt</label>
                <textarea id="fPrompt" placeholder="Describe the image..."></textarea>
            </div>
            <div class="form-row">
                <div class="form-field">
                    <label>Category</label>
                    <select id="fCategory"></select>
                </div>
                <div class="form-field">
                    <label>Aspect Ratio</label>
                    <select id="fAspect">
                        <option value="1:1">1:1</option>
                        <option value="16:9">16:9</option>
                        <option value="9:16">9:16</option>
                        <option value="4:3">4:3</option>
                        <option value="3:4">3:4</option>
                    </select>
                </div>
            </div>
            <div class="form-field">
                <label>Tags (comma separated)</label>
                <input type="text" id="fTags" placeholder="anime, portrait">
            </div>
            <div class="form-field">
                <label>Source URL (optional)</label>
                <input type="text" id="fUrl" placeholder="https://...">
            </div>
            <div class="form-actions">
                <button class="btn btn-secondary btn-small" onclick="closeForm()">Cancel</button>
                <button class="btn btn-primary btn-small" onclick="savePrompt()">Save</button>
            </div>
        </div>
    </div>

    <div class="toast" id="toast"></div>

    <script>
    let galleryData = null;

    async function loadGallery() {
        const res = await fetch('/api/gallery');
        galleryData = await res.json();
        render();
    }

    function render() {
        const container = document.getElementById('galleryContent');
        if (!galleryData || !galleryData.categories) {
            container.innerHTML = '<p class="empty-state">No prompts yet</p>';
            return;
        }

        // Populate category select
        const catSelect = document.getElementById('fCategory');
        catSelect.innerHTML = galleryData.categories.map(c =>
            `<option value="${c.name}">${c.name}</option>`
        ).join('');

        let html = '';
        galleryData.categories.forEach(cat => {
            if (!cat.prompts || cat.prompts.length === 0) return;
            html += `<div class="skill-section">`;
            html += `<div class="section-title">${cat.name}</div>`;
            html += `<div class="prompt-grid">`;
            cat.prompts.forEach((p, idx) => {
                const tagsStr = (p.tags || []).join(', ');
                html += `
                <div class="prompt-card" onclick="goT2I('${esc(cat.name)}', ${idx})">
                    <div class="prompt-card-actions">
                        <button class="btn-icon" onclick="event.stopPropagation();copyPrompt('${esc(cat.name)}',${idx})" title="Copy"><svg viewBox="0 -960 960 960"><path d="M360-240q-33 0-56.5-23.5T280-320v-480q0-33 23.5-56.5T360-880h360q33 0 56.5 23.5T800-800v480q0 33-23.5 56.5T720-240H360Zm0-80h360v-480H360v480ZM200-80q-33 0-56.5-23.5T120-160v-560h80v560h440v80H200Zm160-240v-480 480Z"/></svg></button>
                        ${p.url ? `<a class="btn-icon" href="${esc(p.url)}" target="_blank" rel="noopener" onclick="event.stopPropagation()" title="Source"><svg viewBox="0 -960 960 960"><path d="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h280v80H200v560h560v-280h80v280q0 33-23.5 56.5T760-120H200Zm188-212-56-56 372-372H560v-80h280v280h-80v-144L388-332Z"/></svg></a>` : ''}
                        <button class="btn-icon" onclick="event.stopPropagation();editPrompt('${esc(cat.name)}',${idx})" title="Edit"><svg viewBox="0 -960 960 960"><path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"/></svg></button>
                        <button class="btn-icon delete" onclick="event.stopPropagation();deletePrompt('${esc(cat.name)}',${idx})" title="Delete"><svg viewBox="0 -960 960 960"><path d="m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"/></svg></button>
                    </div>
                    <div class="prompt-card-title">${esc(p.title)}</div>
                    <div class="prompt-card-text">${esc(p.prompt)}</div>
                    <div class="prompt-card-meta">
                        <span class="prompt-badge">${p.aspect || '1:1'}</span>
                        <span class="prompt-tags">${esc(tagsStr)}</span>
                    </div>
                </div>`;
            });
            html += `</div></div>`;
        });
        container.innerHTML = html;
    }

    function esc(s) {
        if (!s) return '';
        return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }

    function goT2I(catName, idx) {
        const cat = galleryData.categories.find(c => c.name === catName);
        if (!cat) return;
        const p = cat.prompts[idx];
        if (!p) return;
        sessionStorage.setItem('gallery_prompt', p.prompt);
        sessionStorage.setItem('gallery_aspect', p.aspect || '1:1');
        window.location.href = '/skills/dev-run-t2i';
    }

    function copyPrompt(catName, idx) {
        const cat = galleryData.categories.find(c => c.name === catName);
        if (!cat) return;
        const p = cat.prompts[idx];
        navigator.clipboard.writeText(p.prompt).then(() => showToast('Copied'));
    }

    function openForm() {
        document.getElementById('formTitle').textContent = 'Add Prompt';
        document.getElementById('editCategory').value = '';
        document.getElementById('editIndex').value = '';
        document.getElementById('fTitle').value = '';
        document.getElementById('fPrompt').value = '';
        document.getElementById('fAspect').value = '1:1';
        document.getElementById('fTags').value = '';
        document.getElementById('fUrl').value = '';
        document.getElementById('formOverlay').classList.add('active');
    }

    function editPrompt(catName, idx) {
        const cat = galleryData.categories.find(c => c.name === catName);
        if (!cat) return;
        const p = cat.prompts[idx];
        document.getElementById('formTitle').textContent = 'Edit Prompt';
        document.getElementById('editCategory').value = catName;
        document.getElementById('editIndex').value = idx;
        document.getElementById('fTitle').value = p.title;
        document.getElementById('fPrompt').value = p.prompt;
        document.getElementById('fCategory').value = catName;
        document.getElementById('fAspect').value = p.aspect || '1:1';
        document.getElementById('fTags').value = (p.tags || []).join(', ');
        document.getElementById('fUrl').value = p.url || '';
        document.getElementById('formOverlay').classList.add('active');
    }

    function closeForm() {
        document.getElementById('formOverlay').classList.remove('active');
    }

    async function savePrompt() {
        const title = document.getElementById('fTitle').value.trim();
        const prompt = document.getElementById('fPrompt').value.trim();
        const category = document.getElementById('fCategory').value;
        const aspect = document.getElementById('fAspect').value;
        const tags = document.getElementById('fTags').value.split(',').map(t => t.trim()).filter(Boolean);
        const url = document.getElementById('fUrl').value.trim();

        if (!title || !prompt) {
            showToast('Title and prompt required');
            return;
        }

        const editCat = document.getElementById('editCategory').value;
        const editIdx = document.getElementById('editIndex').value;

        const body = { title, prompt, category, aspect, tags, url: url || undefined };
        if (editCat && editIdx !== '') {
            body.editCategory = editCat;
            body.editIndex = parseInt(editIdx);
        }

        await fetch('/api/gallery', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });

        closeForm();
        await loadGallery();
        showToast(editCat ? 'Updated' : 'Added');
    }

    async function deletePrompt(catName, idx) {
        if (!confirm('Delete this prompt?')) return;
        await fetch(`/api/gallery/${encodeURIComponent(catName)}/${idx}`, { method: 'DELETE' });
        await loadGallery();
        showToast('Deleted');
    }

    function showToast(msg) {
        const el = document.getElementById('toast');
        el.textContent = msg;
        el.classList.add('show');
        setTimeout(() => el.classList.remove('show'), 2000);
    }

    async function fetchNew() {
        const btn = document.getElementById('btnFetch');
        btn.disabled = true;
        btn.textContent = 'Fetching...';
        try {
            const res = await fetch('/api/gallery/fetch', { method: 'POST' });
            const result = await res.json();
            if (result.error) {
                showToast('Error: ' + result.error);
            } else {
                showToast(`+${result.added || 0} prompts from Civitai`);
                await loadGallery();
            }
        } catch (e) {
            showToast('Fetch failed');
        }
        btn.disabled = false;
        btn.textContent = 'Fetch New';
    }

    loadGallery();
    </script>
</body>
</html>
