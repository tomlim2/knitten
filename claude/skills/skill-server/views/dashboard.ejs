<!-- Design System: v1.5.1 -->
<!DOCTYPE html>
<html lang="ko">
<head>
    <%- include('partials/head', {config}) %>
</head>
<body>
    <%- include('partials/header', {config, activePage}) %>
    <main class="main">
        <div class="skill-count">
            <span class="skill-count-number"><%= skillCount %></span> skill<%= skillCount !== 1 ? 's' : '' %> registered
        </div>

        <%
        // Calculate most used items
        const mostUsed = [];
        if (usageStats.skills) {
            Object.entries(usageStats.skills).forEach(([id, data]) => {
                mostUsed.push({ type: 'skill', id, name: id, count: data.count, lastUsed: data.lastUsed });
            });
        }
        if (usageStats.commands) {
            Object.entries(usageStats.commands).forEach(([id, data]) => {
                mostUsed.push({ type: 'command', id, name: `/${id}`, count: data.count, lastUsed: data.lastUsed });
            });
        }
        mostUsed.sort((a, b) => b.count - a.count);
        const topUsed = mostUsed.slice(0, 5);
        %>

        <% if (topUsed.length > 0) { %>
        <section class="most-used">
            <h2 class="most-used-title">Most Used</h2>
            <div class="most-used-grid">
                <% topUsed.forEach(item => { %>
                <div class="most-used-item">
                    <div class="most-used-name"><%= item.name %></div>
                    <div class="most-used-meta">
                        <span class="most-used-count"><%= item.count %> use<%= item.count !== 1 ? 's' : '' %></span>
                    </div>
                </div>
                <% }); %>
            </div>
        </section>
        <% } %>

        <% groupedSkills.forEach(group => { %>
        <section class="skill-section">
            <div class="skill-grid">
                <% group.skills.forEach(skill => { %>
                <div class="skill-card">
                    <div class="skill-content">
                        <h3 class="skill-name<%= skill.type === 'cli' ? ' skill-name--cli' : '' %>"><a href="/skills/<%= skill.id %>"><%= skill.type === 'cli' ? '/' : '' %><%= skill.name %></a></h3>
                        <div class="skill-meta">
                            <span class="skill-version">v<%= skill.version %></span>
                            <% if (skill.platform && skill.platform !== 'all') { %>
                            <span class="skill-platform skill-platform--<%= skill.platform %>"><%= skill.platform === 'win' ? 'Win' : 'Mac' %></span>
                            <% } %>
                        </div>
                        <p class="skill-description"><%= skill.description %></p>
                    </div>
                </div>
                <% }); %>
            </div>
        </section>
        <% }); %>

        <% if (groupedSkills.length === 0) { %>
        <p class="empty-state">No skills found in ~/.claude/skills/</p>
        <% } %>
    </main>
    <%- include('partials/footer', {config}) %>

    <script>
    // Track skill usage
    document.querySelectorAll('.skill-name a').forEach(link => {
        link.addEventListener('click', function(e) {
            const skillId = this.getAttribute('href').split('/skills/')[1];
            if (skillId) {
                fetch('/api/usage/track', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ type: 'skills', id: skillId })
                }).catch(err => console.error('Failed to track usage:', err));
            }
        });
    });
    </script>
</body>
</html>
