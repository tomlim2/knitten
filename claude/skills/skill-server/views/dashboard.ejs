<!DOCTYPE html>
<html lang="ko">
<head>
    <%- include('partials/head', {config}) %>
</head>
<body>
    <%- include('partials/header', {config, activePage}) %>
    <main class="main">
        <div class="skill-grid">
            <% skills.forEach(skill => { %>
            <a href="/skills/<%= skill.id %>" class="skill-card">
                <div class="skill-content">
                    <h3 class="skill-name skill-name--<%= skill.type %>"><% if (skill.type === 'cli') { %>/<% } %><%= skill.name %></h3>
                    <div class="skill-meta">
                        <span class="skill-badge"><%= skill.type %></span>
                        <span class="skill-version">v<%= skill.version %></span>
                    </div>
                    <p class="skill-description"><%= skill.description %></p>
                </div>
            </a>
            <% }); %>
        </div>

        <% if (skills.length === 0) { %>
        <p class="empty-state">No skills found in ~/.claude/skills/</p>
        <% } %>
    </main>
    <%- include('partials/footer', {config}) %>
</body>
</html>
