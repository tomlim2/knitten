<!-- Design System: v1.9.0 -->
<!DOCTYPE html>
<html lang="ko">
<head>
    <%- include('partials/head', {config}) %>
</head>
<body>
    <%- include('partials/header', {config, activePage}) %>
    <main class="main">
        <div class="server-status">
            <%= totalCount %> registered · Server connected<% if (anjuConnected) { %> · anju connected<% } %>
        </div>

        <% groupedSkills.forEach(group => { %>
        <section class="skill-section">
            <div class="skill-grid">
                <% group.skills.forEach(skill => { %>
                <div class="skill-card">
                    <div class="skill-content">
                        <% if (skill.type === 'command') { %>
                        <h3 class="skill-name skill-name--cli">/<%= skill.name %></h3>
                        <% } else { %>
                        <h3 class="skill-name<%= skill.type === 'cli' ? ' skill-name--cli' : '' %>"><a href="/skills/<%= skill.id %>"><%= skill.type === 'cli' ? '/' : '' %><%= skill.name %></a></h3>
                        <% } %>
                        <p class="skill-description"><%= skill.description %></p>
                    </div>
                </div>
                <% }); %>
            </div>
        </section>
        <% }); %>

        <% if (groupedSkills.length === 0) { %>
        <p class="empty-state">No skills found</p>
        <% } %>
    </main>
    <%- include('partials/footer', {config}) %>
</body>
</html>
