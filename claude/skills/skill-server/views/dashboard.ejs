<!-- Design System: v1.9.0 -->
<!DOCTYPE html>
<html lang="ko">
<head>
    <%- include('partials/head', {config}) %>
</head>
<body>
    <%- include('partials/header', {config, activePage}) %>
    <main class="main">
        <ul class="item-list">
            <% allItems.forEach((item, i) => { %>
            <li>
                <span class="item-index"><%= i + 1 %></span>
                <span class="item-type-icon" title="<%= item.type === 'command' ? 'command' : 'skill' %>"><%= item.type === 'command' ? 'C' : 'S' %></span>
                <% if (item.type !== 'command') { %>
                <a href="/skills/<%= item.id %>" class="item-name--mono">/<%= item.name %></a>
                <% } else { %>
                <span class="item-name--mono">/<%= item.name %></span>
                <% } %>
                <span class="item-meta"><%= item.description || '' %></span>
            </li>
            <% }); %>
        </ul>

        <% if (allItems.length === 0) { %>
        <p class="empty-state">No skills found</p>
        <% } %>
    </main>
    <%- include('partials/footer', {config}) %>
</body>
</html>
