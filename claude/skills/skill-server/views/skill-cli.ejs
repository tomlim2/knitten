<!-- Design System: v1.7.0 -->
<!DOCTYPE html>
<html lang="ko">
<head>
    <% const pageTitle = skill.name %>
    <%- include('partials/head', {config, pageTitle}) %>
    <script src="/static/scripts/marked.js"></script>
</head>
<body>
    <%- include('partials/header', {config, activePage}) %>
    <main class="main">
        <section class="page-hero page-hero--single">
            <div class="page-hero-content">
                <h1 class="page-hero-name">/<%= skill.name %></h1>
                <p class="page-hero-desc"><%= skill.description %></p>
                <div class="page-hero-meta-grid">
                    <div class="page-hero-meta-item">
                        <div class="page-hero-meta-label">Command</div>
                        <div class="page-hero-meta-value">
                            <code>/<%= skill.id %></code>
                        </div>
                    </div>
                    <div class="page-hero-meta-item">
                        <div class="page-hero-meta-label">Version</div>
                        <div class="page-hero-meta-value">
                            v<%= skill.version %>
                        </div>
                    </div>
                    <div class="page-hero-meta-item">
                        <div class="page-hero-meta-label">Type</div>
                        <div class="page-hero-meta-value">
                            <%= skill.type %>
                        </div>
                    </div>
                    <div class="page-hero-meta-item">
                        <div class="page-hero-meta-label">Path</div>
                        <div class="page-hero-meta-value">
                            <code>~/.claude/skills/<%= skill.id %>/</code>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <div class="page-layout">
            <article class="page-main" id="skillContent"></article>
        </div>
    </main>
    <%- include('partials/footer', {config}) %>

    <script>
        const markdown = `<%- skill.markdown.replace(/`/g, '\\`').replace(/\$/g, '\\$') %>`;

        // Remove title and version from markdown
        let content = markdown
            .replace(/^# .+\n/m, '')
            .replace(/\*\*Version:\*\* .+\n/m, '')
            .trim();

        // Parse markdown with marked.js
        const html = marked.parse(content);
        document.getElementById('skillContent').innerHTML = html;
    </script>
</body>
</html>
