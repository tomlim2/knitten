<!-- Design System: v1.9.0 -->
<header class="header">
    <a href="/" class="logo"><%= config.title %></a>
    <nav class="nav">
        <% config.nav.forEach(item => { %>
        <% if (item.disabled) { %>
        <span class="nav-link-disabled"><%= item.label %></span>
        <% } else { %>
        <a href="<%= item.href %>" <% if (typeof activePage !== 'undefined' && activePage === item.href) { %>class="active"<% } %>><%= item.label %></a>
        <% if (typeof activePage !== 'undefined' && activePage === item.href && typeof subPage !== 'undefined' && subPage) { %>
        <span class="nav-sub"><span class="nav-sub-sep">/</span><%= subPage %></span>
        <% } %>
        <% } %>
        <% }); %>
    </nav>
</header>
