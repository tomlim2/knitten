<!-- Design System: v1.9.0 -->
<!DOCTYPE html>
<html lang="ko">
<head>
    <%- include('partials/head', {config}) %>
</head>
<body>
    <%- include('partials/header', {config, activePage}) %>
    <main class="main">
        <section class="home-hero">
            <img src="/static/images/caol-ila-hero.png" alt="Caol Ila" class="home-hero-image">
        </section>

        <div class="server-status">
            <%= totalCount %> registered · Server connected
        </div>

        <section class="home-section">
            <h2 class="section-title">Hardware</h2>
            <% if (hardware) { %>
            <p class="home-hardware-summary"><%= hardware.chip %> · <%= hardware.memory_gb %>GB · <%= hardware.gpu %> · <%= hardware.os %></p>
            <% } else { %>
            <p class="home-empty">hardware.json 없음 — /system-save-hardware 실행</p>
            <% } %>
        </section>

        <% if (typeof plugins !== 'undefined' && plugins.length > 0) { %>
        <section class="home-section">
            <h2 class="section-title">Plugins</h2>
            <ul class="home-file-list">
                <% plugins.forEach(plugin => { %>
                <li>
                    <span class="home-repo-status <% if (plugin.connected) { %>home-repo-connected<% } %>"></span>
                    <% if (plugin.runtime) { %>
                    <button
                        type="button"
                        class="home-repo-runtime <% if (plugin.runtime.running) { %>home-repo-runtime-on<% } else { %>home-repo-runtime-off<% } %>"
                        data-repo="<%= plugin.name %>"
                        data-action="<% if (plugin.runtime.running) { %>stop<% } else { %>start<% } %>"
                        title="<% if (plugin.runtime.running) { %>Running (PID <%= plugin.runtime.pid %>) — click to stop<% } else { %>Stopped — click to start<% } %>"
                        onclick="toggleRepoRuntime(this)">
                        <% if (plugin.runtime.running) { %>🔗<% } else { %>🔌<% } %>
                    </button>
                    <% } %>
                    <span class="home-file-name"><%= plugin.name %></span>
                    <span class="home-repo-path"><%= plugin.path %></span>
                </li>
                <% }); %>
            </ul>
        </section>
        <% } %>

        <section class="home-section">
            <h2 class="section-title">Refs</h2>
            <% if (refs.length > 0) { %>
            <ul class="home-file-list">
                <% refs.forEach(ref => { %>
                <li>
                    <span class="home-repo-status <% if (ref.connected) { %>home-repo-connected<% } %>"></span>
                    <% if (ref.runtime) { %>
                    <button
                        type="button"
                        class="home-repo-runtime <% if (ref.runtime.running) { %>home-repo-runtime-on<% } else { %>home-repo-runtime-off<% } %>"
                        data-repo="<%= ref.name %>"
                        data-action="<% if (ref.runtime.running) { %>stop<% } else { %>start<% } %>"
                        title="<% if (ref.runtime.running) { %>Running (PID <%= ref.runtime.pid %>) — click to stop<% } else { %>Stopped — click to start<% } %>"
                        onclick="toggleRepoRuntime(this)">
                        <% if (ref.runtime.running) { %>🔗<% } else { %>🔌<% } %>
                    </button>
                    <% } %>
                    <span class="home-file-name"><%= ref.name %></span>
                    <span class="home-repo-path"><%= ref.path %></span>
                </li>
                <% }); %>
                <script>
                async function toggleRepoRuntime(btn) {
                    const repo = btn.dataset.repo;
                    const action = btn.dataset.action;
                    btn.disabled = true;
                    try {
                        const res = await fetch(`/api/repos/${repo}/${action}`, { method: 'POST' });
                        if (!res.ok) {
                            const err = await res.json().catch(() => ({}));
                            alert(`${action} failed: ${err.error || res.status}`);
                            btn.disabled = false;
                            return;
                        }
                        // Wait briefly so pgrep sees the new state, then reload.
                        setTimeout(() => location.reload(), 600);
                    } catch (e) {
                        alert(`${action} failed: ${e}`);
                        btn.disabled = false;
                    }
                }
                </script>
            </ul>
            <% } else { %>
            <p class="home-empty">참조된 경로가 없습니다</p>
            <% } %>
        </section>

        <section class="home-section">
            <h2 class="section-title">Recent Learnings</h2>
            <% if (recentLearnings.length > 0) { %>
            <ul class="home-file-list">
                <% recentLearnings.forEach(item => { %>
                <li>
                    <span class="home-file-name"><%= item.name %></span>
                    <span class="home-file-date"><%= new Date(item.mtime).toLocaleDateString('ko-KR', { month: 'numeric', day: 'numeric' }) %></span>
                </li>
                <% }); %>
            </ul>
            <% } else { %>
            <p class="home-empty">아직 기록이 없습니다</p>
            <% } %>
        </section>

        <section class="home-section">
            <h2 class="section-title">Recent Wines</h2>
            <% if (recentWines.length > 0) { %>
            <ul class="home-file-list">
                <% recentWines.forEach(wine => { %>
                <li>
                    <span class="home-file-name"><%= wine.name %></span>
                    <span class="home-wine-type"><%= wine.type.replace(/^(Red|White|Sparkling|Rosé|Natural)\s*Wine\s*-?\s*/, '') %></span>
                    <span class="home-file-date"><%= new Date(wine.date).toLocaleDateString('ko-KR', { month: 'numeric', day: 'numeric' }) %></span>
                </li>
                <% }); %>
            </ul>
            <% } else { %>
            <p class="home-empty">아직 기록이 없습니다</p>
            <% } %>
        </section>

        <section class="home-section">
            <h2 class="section-title">Recent Standards</h2>
            <% if (recentStandards.length > 0) { %>
            <ul class="home-file-list">
                <% recentStandards.forEach(item => { %>
                <li>
                    <span class="home-file-name"><%= item.name %></span>
                    <span class="home-file-date"><%= new Date(item.mtime).toLocaleDateString('ko-KR', { month: 'numeric', day: 'numeric' }) %></span>
                </li>
                <% }); %>
            </ul>
            <% } else { %>
            <p class="home-empty">아직 기록이 없습니다</p>
            <% } %>
        </section>

    </main>
    <%- include('partials/footer', {config}) %>
</body>
</html>
