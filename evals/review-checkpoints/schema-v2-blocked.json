      },
      "expectedError": "invalid-blocked-state"
    },
    {
      "caseId": "blocked-wrong-action",
      "input": {
        "status": "blocked",
        "remainingBlockers": [{ "id": "V1", "priority": "P2", "blocker": true, "source": "validation", "summary": "Unavailable service.", "requiredFix": "Restore it." }],
        "ready": false,
        "nextAction": "complete",
        "blockedHandoff": { "owner": "ops", "requiredAction": "Restore it.", "reason": "Not locally mutable." }
      },
      "expectedError": "invalid-blocked-state"
    },
    {
      "caseId": "blocked-p3-priority",
      "input": {
        "status": "blocked",
        "remainingBlockers": [{ "id": "V1", "priority": "P3", "blocker": true, "source": "validation", "summary": "Optional issue.", "requiredFix": "Do not block." }],
        "ready": false,
        "nextAction": "fix",
        "blockedHandoff": { "owner": "ops", "requiredAction": "Restore it.", "reason": "Not locally mutable." }
      },
      "expectedError": "invalid-blocked-state"
    },
    {
      "caseId": "blocked-unknown-priority",
      "input": {
        "status": "blocked",
        "remainingBlockers": [{ "id": "V1", "priority": "critical", "blocker": true, "source": "validation", "summary": "Unknown priority.", "requiredFix": "Re-review." }],
        "ready": false,
        "nextAction": "fix",
        "blockedHandoff": { "owner": "ops", "requiredAction": "Restore it.", "reason": "Not locally mutable." }
      },
      "expectedError": "invalid-blocked-state"
    },
    {
      "caseId": "blocked-non-blocking-entry",
      "input": {
        "status": "blocked",
        "remainingBlockers": [{ "id": "V1", "priority": "P2", "blocker": false, "source": "validation", "summary": "Not marked blocking.", "requiredFix": "Re-review." }],
        "ready": false,
        "nextAction": "fix",
        "blockedHandoff": { "owner": "ops", "requiredAction": "Restore it.", "reason": "Not locally mutable." }
