{
  "schemaVersion": 2,
  "caseId": "schema-v2-blocked",
  "validState": {
    "status": "blocked",
    "remainingBlockers": [
      {
        "id": "V1",
        "priority": "P2",
        "blocker": true,
        "source": "validation",
        "summary": "External signing service is unavailable.",
        "requiredFix": "Restore the signing service before local validation can continue."
      }
    ],
    "ready": false,
    "nextAction": "fix",
    "blockedHandoff": {
      "owner": "release operations",
