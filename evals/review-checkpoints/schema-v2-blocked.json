        "ready": false,
        "nextAction": "fix",
        "blockedHandoff": { "requiredAction": "Restore it.", "reason": "Not locally mutable." }
      },
      "expectedError": "unknown-key"
    },
    {
      "caseId": "extra-handoff-key",
      "input": {
        "status": "blocked",
        "remainingBlockers": [{ "id": "V1", "priority": "P2", "blocker": true, "source": "validation", "summary": "Unavailable service.", "requiredFix": "Restore it." }],
        "ready": false,
        "nextAction": "fix",
        "blockedHandoff": { "owner": "ops", "requiredAction": "Restore it.", "reason": "Not locally mutable.", "extra": true }
      },
      "expectedError": "unknown-key"
    },
    {
