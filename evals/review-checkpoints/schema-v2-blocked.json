      "input": {
        "status": "blocked",
        "remainingBlockers": [{ "id": "V1", "priority": "P2", "blocker": true, "source": "validation", "summary": "Unavailable service.", "requiredFix": "Restore it." }],
        "ready": false,
        "nextAction": "fix",
        "blockedHandoff": { "owner": "ops", "requiredAction": "Restore it.", "reason": "Not locally mutable." },
        "extra": true
      },
      "expectedError": "unknown-key"
    },
    {
      "caseId": "extra-blocker-key",
      "input": {
        "status": "blocked",
        "remainingBlockers": [{ "id": "V1", "priority": "P2", "blocker": true, "source": "validation", "summary": "Unavailable service.", "requiredFix": "Restore it.", "extra": true }],
        "ready": false,
        "nextAction": "fix",
        "blockedHandoff": { "owner": "ops", "requiredAction": "Restore it.", "reason": "Not locally mutable." }
      },
      "expectedError": "unknown-key"
    },
    {
      "caseId": "non-blocked-handoff",
      "input": {
        "status": "continue",
        "remainingBlockers": [{ "id": "V1", "priority": "P2", "blocker": true, "source": "validation", "summary": "Actionable locally.", "requiredFix": "Fix it." }],
