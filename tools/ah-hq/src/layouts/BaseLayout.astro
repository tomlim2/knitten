---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';
import '../styles/global.css';

interface Props {
    title?: string;
    activeNav?: string;
}
const { title = 'Agent Hub HQ', activeNav } = Astro.props;
---

<!doctype html>
<html lang="ko">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title === 'Agent Hub HQ' ? title : `${title} | Agent Hub HQ`}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Sans+KR:wght@400;500;600&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <Header activeNav={activeNav} />
        <main class="hq-main">
            <slot />
        </main>
        <Footer />
        <CommandPalette />
    </body>
</html>
