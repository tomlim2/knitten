---
import WidgetFrame from '../WidgetFrame.astro';
import EmptyState from '../EmptyState.astro';
import { walkMarkdown } from '../../lib/doc-discovery';
import { vaultProjectDir } from '../../lib/paths';
import { join } from 'node:path';

const projectDir = vaultProjectDir('agent-hub');
const root = projectDir ? join(projectDir, 'learnings') : null;

let items: Array<{ slug: string; name: string; mtime: Date }> = [];
let error: string | null = null;
if (!root) {
    error = 'obsidian vault 미등록';
} else {
    try {
        items = walkMarkdown(root)
            .sort((a, b) => b.mtime.getTime() - a.mtime.getTime())
            .slice(0, 5);
    } catch (e) {
        error = `read failed: ${(e as Error).message}`;
    }
}

function fmt(d: Date) {
    return d.toLocaleDateString('ko-KR', { month: 'numeric', day: 'numeric' });
}
---

<WidgetFrame title="Recent Learnings" id="recent-learnings">
    {error ? (
        <EmptyState tone="error">{error}</EmptyState>
    ) : items.length === 0 ? (
        <EmptyState>아직 기록 없음</EmptyState>
    ) : (
        <ul class="hq-doc-list">
            {items.map(i => (
                <li class="hq-doc-row">
                    <a href={`/learnings/${i.slug}`} class="hq-doc-name">{i.name}</a>
                    <span class="hq-doc-date">{fmt(i.mtime)}</span>
                </li>
            ))}
        </ul>
    )}
    <Fragment slot="foot">
        <a href="/learnings">전체 목록 →</a>
    </Fragment>
</WidgetFrame>
