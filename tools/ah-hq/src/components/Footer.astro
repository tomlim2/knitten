---
import pkg from '../../package.json' with { type: 'json' };
const port = 9720;
const startedAt = new Date().toLocaleString('ko-KR', { dateStyle: 'short', timeStyle: 'short' });
---

<footer class="hq-footer">
    <div class="hq-footer-row">
        <span>Agent Hub HQ <code>v{pkg.version ?? '0.0.0'}</code></span>
        <span>· port <code>{port}</code></span>
        <span>· started <code>{startedAt}</code></span>
        <span>· <a href="/sitemap">sitemap</a></span>
    </div>
</footer>
