---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import EmptyState from '../../components/EmptyState.astro';
import { walkMarkdown } from '../../lib/doc-discovery';
import { obsidianVaultDir, vaultRootFolder } from '../../lib/paths';
import { join } from 'node:path';

const vaultDir = obsidianVaultDir();
const root = vaultDir ? join(vaultDir, vaultRootFolder('projects'), 'caol-ila', 'learnings') : null;
const docs = root ? walkMarkdown(root).sort((a, b) => b.mtime.getTime() - a.mtime.getTime()) : [];

function fmt(d: Date) {
    return d.toLocaleDateString('ko-KR', { month: 'numeric', day: 'numeric' });
}
---

<BaseLayout title="Learnings" activeNav="/browse">
    <PageHero title="Learnings" sub={`${docs.length} 개 · ${root ?? 'obsidian vault not configured'}`} />
    {!root ? (
        <EmptyState tone="error">obsidian vault 경로가 등록되지 않았습니다.</EmptyState>
    ) : (
        <ul class="hq-skill-list">
            {docs.map(d => (
                <li class="hq-skill-row">
                    <a href={`/learnings/${d.slug}`} class="hq-skill-name">{d.name}</a>
                    <span class="hq-skill-desc">{d.slug.includes('/') ? d.slug.replace(`/${d.name}`, '') : '·'} <span style="color:var(--color-gray-mid);font-family:var(--font-mono);font-size:11px;">{fmt(d.mtime)}</span></span>
                </li>
            ))}
        </ul>
    )}
</BaseLayout>
